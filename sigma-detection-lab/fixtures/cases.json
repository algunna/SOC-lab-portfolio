{
  "windows_powershell_encoded.yml": [
    {
      "event": {
        "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "CommandLine": "powershell.exe -EncodedCommand AAAA"
      },
      "match": true
    },
    {
      "event": {
        "Image": "C:\\Windows\\System32\\cmd.exe",
        "CommandLine": "-EncodedCommand AAAA"
      },
      "match": false
    },
    {
      "event": {
        "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "CommandLine": "powershell.exe -NoProfile"
      },
      "match": false
    },
    {
      "event": {
        "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "CommandLine": "powershell.exe -e SQBFAFgA"
      },
      "match": true
    },
    {
      "event": {
        "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "CommandLine": "powershell.exe -nop /ec SQBFAFgA"
      },
      "match": true
    },
    {
      "event": {
        "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "CommandLine": "powershell.exe -w hidden -enc"
      },
      "match": true
    },
    {
      "event": {
        "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "CommandLine": "powershell.exe -ExecutionPolicy Bypass -File a.ps1"
      },
      "match": false
    }
  ],
