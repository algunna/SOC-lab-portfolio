{
  "schema_version": "1.0",
  "scope": "synthetic_policy_expectations_not_real_world_accuracy",
  "scenarios": [
    {
      "id": "win-encoded-command",
      "detector": "windows",
      "events": [
        {
          "event_id": 4688,
          "timestamp": "2026-10-14T12:00:00Z",
          "host": "LAB-WS01",
          "user": "labuser",
          "image": "C:\\Windows\\System32\\powershell.exe",
          "command_line": "powershell.exe -EncodedCommand QUJD"
        }
      ],
      "expected_rules": [
        "suspicious_powershell"
      ],
      "reason": "Encoded command flag is a review indicator, not proof of maliciousness"
    },
    {
      "id": "win-short-encoded-switch",
      "detector": "windows",
      "events": [
        {
          "event_id": 4688,
          "timestamp": "2026-10-14T12:00:00Z",
          "host": "LAB-WS01",
          "user": "labuser",
          "image": "pwsh.exe",
          "command_line": "pwsh.exe /enc QUJD"
        }
      ],
      "expected_rules": [
        "suspicious_powershell"
      ],
      "reason": "Abbreviated encoded-command switch"
    },
