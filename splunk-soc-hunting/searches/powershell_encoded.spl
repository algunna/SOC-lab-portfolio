index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| eval process=lower(coalesce(Image, image, ""))
| eval command=lower(coalesce(CommandLine, command_line, ""))
| where match(process, "(powershell|pwsh)\\.exe$") AND (like(command, "%-encodedcommand%") OR like(command, "%-enc %"))
| table _time host User Image CommandLine ParentImage
